# Keys and model ids for the frontier batch. The single place either lives.
# Copy to arena/.env (gitignored) and fill in OPENROUTER_API_KEY; arena/.env.example is committed.
# A variable already set in the process environment wins over this file.
# Every model is called through OpenRouter (https://openrouter.ai/api/v1) by its slug.

# --- OpenRouter: the one key ---
OPENROUTER_API_KEY=

# --- Anthropic (deferred; not part of the current batch) ---
# Direct key, a fallback if OpenRouter is unavailable:
# ANTHROPIC_API_KEY=
ARENA_MODEL_ANTHROPIC_HAIKU=anthropic/claude-haiku-5.5
ARENA_MODEL_ANTHROPIC_SONNET=anthropic/claude-sonnet-5.5
ARENA_MODEL_ANTHROPIC_OPUS=anthropic/claude-opus-5.5

# --- OpenAI ---
ARENA_MODEL_OPENAI_SOL=openai/gpt-6.2-sol
ARENA_MODEL_OPENAI_LUNA=openai/gpt-6-luna

# --- Google ---
ARENA_MODEL_GOOGLE_FLASH=google/gemini-3.1-flash-lite
ARENA_MODEL_GOOGLE_PRO=google/gemini-3.1-pro-preview

# --- DeepSeek ---
# deepseek/deepseek-flash is not in OpenRouter's model list (checked 2026-11-21); the line is left out
# until a slug is chosen. Listed instead: deepseek/deepseek-v4.1-flash, deepseek/deepseek-v4.1-flash-1017.
# ARENA_MODEL_DEEPSEEK_FLASH=
ARENA_MODEL_DEEPSEEK_PRO=deepseek/deepseek-v4-pro
