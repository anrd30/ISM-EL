# Keys and model ids for the frontier batch. The single place either lives.
# Copy to arena/.env (gitignored) and fill in the four key lines; arena/.env.example is committed.
# A variable already set in the process environment wins over this file.

# --- Anthropic ---
ANTHROPIC_API_KEY=
ARENA_MODEL_ANTHROPIC_HAIKU=claude-haiku-5-5
ARENA_MODEL_ANTHROPIC_SONNET=claude-sonnet-5-5
ARENA_MODEL_ANTHROPIC_OPUS=claude-opus-5-5

# --- OpenAI ---
OPENAI_API_KEY=
ARENA_MODEL_OPENAI_SOL=gpt-6.2-sol

# --- Google ---
GOOGLE_API_KEY=
ARENA_MODEL_GOOGLE_FLASH=gemini-3.1-flash-lite
ARENA_MODEL_GOOGLE_PRO=gemini-3.1-pro-preview

# --- DeepSeek ---
DEEPSEEK_API_KEY=
ARENA_MODEL_DEEPSEEK_FLASH=deepseek-flash
ARENA_MODEL_DEEPSEEK_PRO=deepseek-v4-pro
