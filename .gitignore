# Raw and processed data never goes in git (see CLAUDE.md §9).
# **/ matches at any depth — a bare "data/raw/" only matches a
# top-level folder, which is not where this data lives.
**/data/raw/
**/data/processed/
*.parquet
*.quarter.csv

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
*.egg-info/

# OS / editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
