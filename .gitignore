# Nothing under data_pipeline/data/ goes in git, ever (see CLAUDE.md §9) —
# not raw files, not processed files, not a stray placeholder. Scripts
# create this folder and its subfolders at runtime; git never tracks it.
data_pipeline/data/
*.parquet
*.quarter.csv

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
*.egg-info/

# OS / editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json

.coverage
# A3: fitted hazard artifacts (~218 MB), regenerate with python -m hazard.fit_v1; hashes in hazard/manifest.json
hazard/artifacts/

# Local Claude Code settings (machine-specific, never shared)
.claude/
graphify-out/
_to_delete/

# T-lane: PPO training run output (logs, checkpoints), regenerate with python -m agent.train.
# Committed run evidence goes under agent/evidence/<run>/ instead.
runs/

# Arena run logs (large, machine-specific); the committed evidence is arena/results/.
arena_*.log

# Machine-specific launchers with a baked-in GPU UUID; use run_gpu.sh instead.
run_arena_gpu.sh
run_hf_gpu.sh
run_arena.sh

# arena API keys and model ids (arena/.env.example is committed)
arena/.env
